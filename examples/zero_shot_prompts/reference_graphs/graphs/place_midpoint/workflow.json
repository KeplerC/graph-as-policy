{
 "version": 3,
 "meta": {
  "name": "place_at_midpoint",
  "description": "Reference for computed placement: grasp the butter, perceive the milk and the tomato sauce, compute the xy-midpoint of their centers, and set the butter down there. Proves a perceive-two-references -> compute -> precise-place pipeline is expressible and passes the midpoint criterion."
 },
 "nodes": {
  "target": {"type": "subgraph", "ref": "target_sg"},
  "grasp": {"type": "subgraph", "ref": "grasp_sg"},
  "ref1": {"type": "subgraph", "ref": "ref1_sg"},
  "ref2": {"type": "subgraph", "ref": "ref2_sg"},
  "synth": {"type": "subgraph", "ref": "synth_sg"},
  "transport": {"type": "subgraph", "ref": "transport_sg"},
  "done": {"type": "end", "status": "success"},
  "abort": {"type": "end", "status": "failure",
            "recovery": [{"tool": "robot.open_gripper", "inputs": {}},
                         {"tool": "robot.go_home", "inputs": {}}]}
 },
 "edges": [["START", "target"]],
 "conditional_edges": {
  "target": {"router_field": "exit", "mapping": {"found": "grasp", "not_found": "abort"}},
  "grasp": {"router_field": "exit", "mapping": {"grasped": "ref1", "failed": "abort"}},
  "ref1": {"router_field": "exit", "mapping": {"found": "ref2", "not_found": "abort"}},
  "ref2": {"router_field": "exit", "mapping": {"found": "synth", "not_found": "abort"}},
  "synth": {"router_field": "exit", "mapping": {"ready": "transport", "failed": "abort"}},
  "transport": {"router_field": "exit", "mapping": {"placed": "done", "blocked": "abort"}}
 },
 "subgraphs": {
  "target_sg": {
   "skill": "perceiving-objects", "inputs": {},
   "outputs": {"target_obb": {"$ref": "filter_obb.obb"}, "target_mask": {"$ref": "perceive.mask"}},
   "nodes": {
    "observe": {"type": "tool", "tool": "robot.get_observation"},
    "perceive": {"type": "script", "script": "scripts/target/perceive_dino_vlm.py",
                 "inputs": {"cameras": {"$ref": "observe.cameras"}, "object_name": "small butter box"}},
    "filter_obb": {"type": "tool", "tool": "geometry.filter_and_compute_obb", "inputs": {"points": {"$ref": "perceive.cloud"}}},
    "found": {"type": "noop"}
   },
   "edges": [["START", "observe"], ["observe", "perceive"], ["perceive", "filter_obb"], ["filter_obb", "found"], ["found", "END"]],
   "conditional_edges": {}, "exit": {"router_field": null, "success_values": ["found"]}, "on_error": "not_found"
  },
  "grasp_sg": {
   "skill": "grasping-with-planner", "inputs": {"target_obb": "OrientedBoundingBox"},
   "outputs": {"ee_pose_at_grasp": {"$ref": "observe.arms.0.ee_pose"}},
   "nodes": {
    "open": {"type": "tool", "tool": "robot.open_gripper", "inputs": {"settle_steps": 40}},
    "compute_grasp": {"type": "tool", "tool": "geometry.top_down_grasp_candidates", "inputs": {"obb": {"$ref": "in.target_obb"}, "z_offset": -0.03}},
    "goto_grasp": {"type": "script", "script": "scripts/grasp_move.py",
                   "inputs": {"grasp_pose": {"$ref": "compute_grasp.candidates.poses.0"}, "candidate_poses": {"$ref": "compute_grasp.candidates.poses"}, "target_obb": {"$ref": "in.target_obb"}, "hover_z": 0.2}},
    "observe": {"type": "tool", "tool": "robot.get_observation"},
    "close": {"type": "tool", "tool": "robot.close_gripper", "inputs": {"settle_steps": 60}},
    "grasped": {"type": "noop"}
   },
   "edges": [["START", "open"], ["open", "compute_grasp"], ["compute_grasp", "goto_grasp"], ["goto_grasp", "observe"], ["observe", "close"], ["close", "grasped"], ["grasped", "END"]],
   "conditional_edges": {}, "exit": {"router_field": null, "success_values": ["grasped"]}, "on_error": "failed", "stage": "grasp"
  },
  "ref1_sg": {
   "skill": "perceiving-objects", "inputs": {},
   "outputs": {"ref1_obb": {"$ref": "filter_obb.obb"}},
   "nodes": {
    "observe": {"type": "tool", "tool": "robot.get_observation"},
    "perceive": {"type": "script", "script": "scripts/ref/perceive_dino_vlm.py",
                 "inputs": {"cameras": {"$ref": "observe.cameras"}, "object_name": "milk carton"}},
    "filter_obb": {"type": "tool", "tool": "geometry.filter_and_compute_obb", "inputs": {"points": {"$ref": "perceive.cloud"}}},
    "found": {"type": "noop"}
   },
   "edges": [["START", "observe"], ["observe", "perceive"], ["perceive", "filter_obb"], ["filter_obb", "found"], ["found", "END"]],
   "conditional_edges": {}, "exit": {"router_field": null, "success_values": ["found"]}, "on_error": "not_found"
  },
  "ref2_sg": {
   "skill": "perceiving-objects", "inputs": {},
   "outputs": {"ref2_obb": {"$ref": "filter_obb.obb"}},
   "nodes": {
    "observe": {"type": "tool", "tool": "robot.get_observation"},
    "perceive": {"type": "script", "script": "scripts/ref/perceive_dino_vlm.py",
                 "inputs": {"cameras": {"$ref": "observe.cameras"}, "object_name": "tomato sauce can"}},
    "filter_obb": {"type": "tool", "tool": "geometry.filter_and_compute_obb", "inputs": {"points": {"$ref": "perceive.cloud"}}},
    "found": {"type": "noop"}
   },
   "edges": [["START", "observe"], ["observe", "perceive"], ["perceive", "filter_obb"], ["filter_obb", "found"], ["found", "END"]],
   "conditional_edges": {}, "exit": {"router_field": null, "success_values": ["found"]}, "on_error": "not_found"
  },
  "synth_sg": {
   "skill": "perceiving-objects", "inputs": {"ref1_obb": "OrientedBoundingBox", "ref2_obb": "OrientedBoundingBox", "target_obb": "OrientedBoundingBox"},
   "outputs": {"container_obb": {"$ref": "midpoint.container_obb"}},
   "nodes": {
    "midpoint": {"type": "script", "script": "scripts/compute_midpoint.py",
                 "inputs": {"ref1_obb": {"$ref": "in.ref1_obb"}, "ref2_obb": {"$ref": "in.ref2_obb"}, "target_obb": {"$ref": "in.target_obb"}}},
    "ready": {"type": "noop"}
   },
   "edges": [["START", "midpoint"], ["midpoint", "ready"], ["ready", "END"]],
   "conditional_edges": {}, "exit": {"router_field": null, "success_values": ["ready"]}, "on_error": "failed"
  },
  "transport_sg": {
   "skill": "transporting-objects", "inputs": {"container_obb": "OrientedBoundingBox"},
   "outputs": {"place_position": {"$ref": "transport_move.place_position"}},
   "nodes": {
    "transport_move": {"type": "script", "script": "scripts/transport_move.py",
                       "inputs": {"container_obb": {"$ref": "in.container_obb"}, "place_offset": 0.04}},
    "release": {"type": "script", "script": "scripts/place_release.py", "inputs": {"place_position": {"$ref": "transport_move.place_position"}}},
    "placed": {"type": "noop"}
   },
   "edges": [["START", "transport_move"], ["transport_move", "release"], ["release", "placed"], ["placed", "END"]],
   "conditional_edges": {}, "exit": {"router_field": null, "success_values": ["placed"]}, "on_error": "blocked", "stage": "place"
  }
 }
}
