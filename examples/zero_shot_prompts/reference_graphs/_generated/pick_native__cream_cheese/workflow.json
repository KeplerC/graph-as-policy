{
 "version": 3,
 "meta": {
  "name": "pick_cream_cheese",
  "description": "Reference: pick the small cream cheese box and place it in the wicker basket."
 },
 "nodes": {
  "target": {
   "type": "subgraph",
   "ref": "target_sg"
  },
  "container": {
   "type": "subgraph",
   "ref": "container_sg"
  },
  "grasp": {
   "type": "subgraph",
   "ref": "grasp_sg"
  },
  "transport": {
   "type": "subgraph",
   "ref": "transport_sg"
  },
  "done": {
   "type": "end",
   "status": "success"
  },
  "abort": {
   "type": "end",
   "status": "failure",
   "recovery": [
    {
     "tool": "robot.open_gripper",
     "inputs": {}
    },
    {
     "tool": "robot.go_home",
     "inputs": {}
    }
   ]
  }
 },
 "edges": [
  [
   "START",
   "target"
  ]
 ],
 "conditional_edges": {
  "target": {
   "router_field": "exit",
   "mapping": {
    "found": "container",
    "not_found": "abort"
   }
  },
  "container": {
   "router_field": "exit",
   "mapping": {
    "found": "grasp",
    "not_found": "abort"
   }
  },
  "grasp": {
   "router_field": "exit",
   "mapping": {
    "grasped": "transport",
    "failed": "abort"
   }
  },
  "transport": {
   "router_field": "exit",
   "mapping": {
    "placed": "done",
    "blocked": "abort"
   }
  }
 },
 "subgraphs": {
  "target_sg": {
   "skill": "perceiving-objects",
   "inputs": {},
   "outputs": {
    "target_obb": {
     "$ref": "filter_obb.obb"
    },
    "target_mask": {
     "$ref": "perceive.mask"
    }
   },
   "nodes": {
    "observe": {
     "type": "tool",
     "tool": "robot.get_observation"
    },
    "perceive": {
     "type": "script",
     "script": "scripts/target/perceive_dino_vlm.py",
     "inputs": {
      "cameras": {
       "$ref": "observe.cameras"
      },
      "object_name": "small cream cheese box"
     }
    },
    "filter_obb": {
     "type": "tool",
     "tool": "geometry.filter_and_compute_obb",
     "inputs": {
      "points": {
       "$ref": "perceive.cloud"
      }
     }
    },
    "found": {
     "type": "noop"
    }
   },
   "edges": [
    [
     "START",
     "observe"
    ],
    [
     "observe",
     "perceive"
    ],
    [
     "perceive",
     "filter_obb"
    ],
    [
     "filter_obb",
     "found"
    ],
    [
     "found",
     "END"
    ]
   ],
   "conditional_edges": {},
   "exit": {
    "router_field": null,
    "success_values": [
     "found"
    ]
   },
   "on_error": "not_found"
  },
  "container_sg": {
   "skill": "perceiving-objects",
   "inputs": {},
   "outputs": {
    "container_obb": {
     "$ref": "filter_obb.obb"
    }
   },
   "nodes": {
    "observe": {
     "type": "tool",
     "tool": "robot.get_observation"
    },
    "perceive": {
     "type": "script",
     "script": "scripts/container/perceive_dino_vlm.py",
     "inputs": {
      "cameras": {
       "$ref": "observe.cameras"
      },
      "object_name": "wicker basket"
     }
    },
    "filter_obb": {
     "type": "tool",
     "tool": "geometry.filter_and_compute_obb",
     "inputs": {
      "points": {
       "$ref": "perceive.cloud"
      }
     }
    },
    "found": {
     "type": "noop"
