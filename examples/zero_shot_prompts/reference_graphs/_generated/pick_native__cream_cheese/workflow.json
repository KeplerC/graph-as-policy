   },
   "on_error": "not_found"
  },
  "grasp_sg": {
   "skill": "grasping-direct-ik",
   "inputs": {
    "target_obb": "OrientedBoundingBox"
   },
   "outputs": {},
   "nodes": {
    "open": {
     "type": "tool",
     "tool": "robot.open_gripper",
     "inputs": {
      "settle_steps": 40
     }
    },
    "compute_grasp": {
     "type": "tool",
     "tool": "geometry.top_down_grasp_candidates",
     "inputs": {
      "obb": {
       "$ref": "in.target_obb"
      }
     }
    },
    "compute_align": {
     "type": "script",
     "script": "scripts/grasp/compute_align_pose.py",
     "inputs": {
      "grasp_pose": {
       "$ref": "compute_grasp.candidates.poses.0"
      },
      "target_obb": {
       "$ref": "in.target_obb"
      }
     }
    },
    "rotate_align": {
     "type": "script",
     "script": "scripts/grasp/move_linear.py",
     "inputs": {
      "pose": {
       "$ref": "compute_align.align_pose"
      }
     }
    },
    "descend": {
     "type": "script",
     "script": "scripts/grasp/move_linear.py",
     "inputs": {
      "pose": {
       "$ref": "compute_grasp.candidates.poses.0"
      }
     }
    },
    "close": {
     "type": "tool",
     "tool": "robot.close_gripper",
     "inputs": {
      "settle_steps": 60
     }
    },
    "grasped": {
     "type": "noop"
    }
   },
   "edges": [
    [
     "START",
     "open"
    ],
    [
     "open",
     "compute_grasp"
    ],
    [
     "compute_grasp",
     "compute_align"
    ],
    [
     "compute_align",
     "rotate_align"
    ],
    [
     "rotate_align",
     "descend"
    ],
    [
     "descend",
     "close"
    ],
    [
     "close",
     "grasped"
    ],
    [
     "grasped",
     "END"
    ]
   ],
   "conditional_edges": {},
   "exit": {
    "router_field": null,
    "success_values": [
     "grasped"
    ]
   },
   "on_error": "failed"
  },
  "transport_sg": {
   "skill": "transporting-objects",
   "inputs": {
    "container_obb": "OrientedBoundingBox"
   },
   "outputs": {
    "placed": {
     "$ref": "release.drop_position"
    }
   },
   "nodes": {
    "compute_drop": {
     "type": "script",
     "script": "scripts/transport/compute_drop_pose.py",
     "inputs": {
      "container_obb": {
       "$ref": "in.container_obb"
      }
     }
    },
    "move_above": {
     "type": "script",
     "script": "scripts/transport/waypoint_move.py",
     "inputs": {
      "drop_x": {
       "$ref": "compute_drop.drop_position.x"
      },
      "drop_y": {
       "$ref": "compute_drop.drop_position.y"
      }
     }
    },
    "release": {
     "type": "script",
     "script": "scripts/transport/descend_release.py",
     "inputs": {
      "drop_position": {
       "$ref": "compute_drop.drop_position"
      }
     }
    },
    "placed": {
     "type": "noop"
    }
   },
   "edges": [
    [
     "START",
     "compute_drop"
    ],
    [
     "compute_drop",
     "move_above"
    ],
    [
     "move_above",
     "release"
    ],
    [
     "release",
     "placed"
    ],
    [
